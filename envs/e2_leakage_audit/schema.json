{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "findings",
    "patched_source"
  ],
  "properties": {
    "findings": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family",
          "line"
        ],
        "properties": {
          "family": {
            "enum": [
              "F1",
              "F2",
              "F3",
              "F4",
              "F5",
              "F6"
            ]
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000
          }
        }
      }
    },
    "patched_source": {
      "type": "string",
      "maxLength": 100000,
      "description": "Additional UTF-8 byte bound of 100000 enforced by parser."
    }
  }
}
