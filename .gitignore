# Generated data and caches
data/
outputs/
.cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/

# Credentials and local configuration
.env
.env.*
*.key
*.pem
secrets/

# Model artifacts
*.ckpt
*.pt
*.pth
*.safetensors
checkpoints/
weights/

# Runtime logs (tracked placeholders and small fixtures remain allowed)
logs/*.log
logs/*.jsonl
logs/*.csv
logs/**/*.log
logs/**/*.jsonl
logs/**/*.csv

# Large files should never be committed. Git cannot enforce size here; CI does.

# P3a bulky rollout evidence is local; committed manifests carry hashes.
artifacts/p3a/

# P3a2 raw evidence retained locally behind tracked SHA manifests.
artifacts/p3a2/

# Unscoped runtime test journals stay local; tracked history is preserved.
logs/p2d3_exceptions/

# P3a3 raw evidence retained locally behind tracked SHA manifests.
artifacts/p3a3/

# E3 local infrastructure journals; compressed proof records are tracked separately.
artifacts/p3b2/

# Retained E3 branch evidence and bounded P5a local journals.
artifacts/p3b3/
artifacts/p5a/

# P5b raw validation records remain local behind committed hash proofs.
artifacts/p5b/
